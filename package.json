{
  "name": "floodplainatlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4322",
    "build": "tsc --noEmit && vite build",
    "build:vercel": "npm run build && node scripts/strip-vercel-data.mjs",
    "build:cloudflare:preview": "cf build --mode preview && tsc -p tsconfig.cloudflare.json",
    "build:cloudflare:production": "cf build --mode cloudflare && tsc -p tsconfig.cloudflare.json",
    "typecheck:cloudflare": "cf build --mode cloudflare && tsc -p tsconfig.cloudflare.json",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 4322",
    "test": "node --experimental-strip-types --test scripts/flood-tile-source.test.mjs",
    "test:browser": "node scripts/browser-smoke.cjs"
  },
  "dependencies": {
    "maplibre-gl": "^6.18.0",
    "pmtiles": "^4.5.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.17",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "cf": "^1.0.0-beta.32",
    "playwright": "1.62.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
